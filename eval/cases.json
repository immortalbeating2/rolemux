      "expected": [["promptSha256"], ["executionConfigSha256"], ["not-reported"]],
      "evidencePaths": ["src/core/run-provenance.ts", "src/core/task-metadata.ts"]
    },
    {
      "id": "execution-budget",
      "question": "Which run limits stop fallback work, and which metadata fields record consumption?",
      "allowedPaths": ["src/commands/run.ts", "src/core/fallback.ts", "src/core/task-metadata.ts"],
      "expected": [["maxAttempts"], ["timeoutMs", "deadlineAt"], ["attemptsUsed"], ["deadlineReached"]],
      "evidencePaths": ["src/commands/run.ts", "src/core/fallback.ts", "src/core/task-metadata.ts"]
    },
    {
      "id": "structured-discussion",
      "question": "List the four structured discussion stages in order.",
      "allowedPaths": ["src/commands/discuss.ts"],
      "expected": [["candidate"], ["counter"], ["verification"], ["synthesis"]],
      "evidencePaths": ["src/commands/discuss.ts"]
    },
    {
      "id": "verification-manifest",
      "question": "What version and command fields are accepted, and is a shell used?",
      "allowedPaths": ["src/core/verification-manifest.ts", "src/core/process-runner.ts"],
      "expected": [["version", "version 1"], ["executable"], ["args"], ["shell: false", "without a shell", "no shell"]],
      "evidencePaths": ["src/core/verification-manifest.ts", "src/core/process-runner.ts"]
    },
    {
      "id": "capability-routing",
      "question": "Which providers are the first two research priorities, and which controls bound selection?",
      "allowedPaths": ["src/core/provider-router.ts"],
      "expected": [["grok"], ["claude"], ["available"], ["exclude"], ["maxProviders"]],
      "evidencePaths": ["src/core/provider-router.ts"]
    }
  ]
}
