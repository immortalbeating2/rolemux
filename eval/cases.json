      "expected": [["git apply --check", "apply --check"], ["merge_conflict", "conflict"]],
      "evidencePaths": ["src/core/merge-patches.ts"]
    },
    {
      "id": "cleanup-boundary",
      "question": "Which managed root bounds worktree cleanup, and what error is raised for an outside path?",
      "allowedPaths": ["src/core/worktree-cleanup.ts"],
      "expected": [[".rolemux/worktrees"], ["worktree_cleanup_unsafe_path", "unsafe path"]],
      "evidencePaths": ["src/core/worktree-cleanup.ts"]
    },
    {
      "id": "context-pack-safety",
      "question": "What is the default per-file byte limit, and name two sensitive basename examples that are skipped.",
      "allowedPaths": ["src/core/context-pack.ts"],
      "expected": [["16384", "16 * 1024", "16 kb", "16 kib"], [".env"], [".npmrc"]],
      "evidencePaths": ["src/core/context-pack.ts"]
    },
    {
      "id": "empty-output",
      "question": "How is a provider process classified when it exits successfully but stdout is empty?",
      "allowedPaths": ["src/core/workflow-runner.ts"],
      "expected": [["failed"], ["no stdout", "empty stdout", "produced no stdout"]],
      "evidencePaths": ["src/core/workflow-runner.ts"]
    },
    {
      "id": "result-contract",
      "question": "Name the result.json schema version and its finding and verification collections.",
      "allowedPaths": ["src/core/task-result.ts"],
      "expected": [["schemaVersion", "schema version"], ["1"], ["findings"], ["verification"]],
      "evidencePaths": ["src/core/task-result.ts"]
    },
    {
      "id": "provenance-contract",
      "question": "Which two SHA-256 fields are recorded, and how is an unknown model reported?",
