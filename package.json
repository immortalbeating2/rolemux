{
  "name": "rolemux",
  "version": "0.1.0",
  "description": "Lightweight multi-CLI role workflow runner for Codex, Claude, Agy, and Grok Build.",
  "type": "module",
  "bin": {
    "rolemux": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "roles",
    "templates",
    "examples",
    "docs/release",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "verify:release": "npm run typecheck && npm test && npm run test:e2e && npm pack --dry-run && git diff --check",
    "lint": "tsc --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "node-pty": "^1.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
